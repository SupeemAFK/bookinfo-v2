pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent-tagging
spec:
  - name: docker
    image: docker:24.0.5
    command: ['cat']
    tty: true
    env:
    - name: DOCKER_HOST
      value: tcp://localhost:2375
"""
        }
    }

    parameters {
        string(name: 'RELEASE_VERSION', description: 'The new version to release (e.g. v1.0.0)', trim: true)
    }

    environment {
        REGISTRY_URL = "registry-supeem.opsta.in.th"
        IMAGE_PATH   = "library/productpage-service"
        FULL_IMAGE   = "${REGISTRY_URL}/${IMAGE_PATH}"
        
        GIT_REPO     = "git@gitlab.com:SupeemAFK/bookinfo.git"
        GIT_CREDS    = "bookinfo-deploy-key"
    }

    stages {
        stage('Checkout Main') {
            steps {
                script {
                    withEnv(['GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no']) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/main"]], 
                            userRemoteConfigs: [[
                                credentialsId: env.GIT_CREDS,
                                url: env.GIT_REPO
                            ]]
                        ])
                    }
                    
                    env.SHORT_HASH = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    echo "Promoting Artifact from Commit: ${env.SHORT_HASH}"
                }
            }
        }

        stage('Promote Docker Image') {
            steps {
                container('docker') {
                    script {
                        // This will print the URL and the length of the username/password 
                        // without leaking the actual secrets in the logs.
                        sh """
                            echo "Attempting login to: ${env.REGISTRY_URL}"
                            echo "Username length: \$(echo -n \$REG_USER | wc -c)"
                            echo "Password length: \$(echo -n \$REG_PASS | wc -c)"
                        """
                        
                        // Use the explicit 'env.' prefix to ensure the URL isn't blank
                        sh 'echo "$REG_PASS" | docker login ${env.REGISTRY_URL} -u "$REG_USER" --password-stdin'
                    }
                }
            }
        }

        stage('Create Git Tag') {
            steps {
                script {
                    sh 'git config user.email "jenkins@opsta.in.th"'
                    sh 'git config user.name "Jenkins Bot"'

                    sh "git tag -a productpage/${params.RELEASE_VERSION} -m 'Release productpage/${params.RELEASE_VERSION}'"
                    
                    withCredentials([sshUserPrivateKey(credentialsId: env.GIT_CREDS, keyFileVariable: 'SSH_KEY_FILE')]) {
                        sh """
                            export GIT_SSH_COMMAND="ssh -i \${SSH_KEY_FILE} -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no"
                            git push origin productpage/${params.RELEASE_VERSION}
                        """
                    }
                }
            }
        }
    }
}