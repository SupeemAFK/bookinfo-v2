pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent-bookinfo
spec:
  containers:
  - name: docker
    image: docker:24.0.5
    command: ['cat']
    tty: true
    securityContext:
      privileged: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: helm
    image: alpine/helm:3.12.0
    command: ['cat']
    tty: true
  - name: sonar-scanner
    image: sonarsource/sonar-scanner-cli:latest
    command: ['cat']
    tty: true
  - name: dependency-check
    image: owasp/dependency-check:latest
    command: ['cat']
    tty: true
    securityContext:
      runAsUser: 0
    volumeMounts:
    - name: sca-data
      mountPath: /usr/share/dependency-check/data
      subPath: "bookinfo-scan"
  - name: trivy
    image: aquasec/trivy:latest
    command: ['cat']
    tty: true
  - name: zap
    image: ghcr.io/zaproxy/zaproxy:stable
    command: ['sh', '-c', 'cat']
    tty: true
  - name: kics
    image: checkmarx/kics:latest
    command: ['cat']
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
  - name: sca-data
    hostPath:
      path: /tmp/dependency-check-data
"""
        }
    }

    environment {
        REGISTRY_URL = "registry-supeem.opsta.in.th"
        IMAGE_PATH   = "library/productpage-service"
        FULL_IMAGE   = "${REGISTRY_URL}/${IMAGE_PATH}"

        CHART_DIR    = "helm-chart/productpage"

        SONAR_SERVER_URL = "https://sast-supeem.opsta.in.th"
        SONAR_PROJECT_KEY = "SupeemAFK_bookinfo_8304fcdc-fe26-4b19-a892-84f8f847e9df"

        SAFE_BRANCH  = "${env.BRANCH_NAME != null ? env.BRANCH_NAME : 'dev'}"
        RELEASE_NAME = "${env.SAFE_BRANCH == 'main' ? 'bookinfo-productpage-uat' : 'bookinfo-productpage-dev'}"
        NAMESPACE    = "${env.SAFE_BRANCH == 'main' ? 'bookinfo-uat' : 'bookinfo-dev'}"
        VALUES_FILE  = "${env.SAFE_BRANCH == 'main' ? 'helm-chart/productpage/uat-productpage-values.yaml' : 'helm-chart/productpage/dev-productpage-values.yaml'}"

        APP_URL      = "http://productpage.${env.NAMESPACE}.svc.cluster.local:9080" 
    }

    stages {
        stage('Checkout & Setup') {
            steps {
                script {
                    withEnv(['GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no']) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${env.SAFE_BRANCH}"]], 
                            userRemoteConfigs: [[
                                credentialsId: 'bookinfo-deploy-key',
                                url: 'git@gitlab.com:SupeemAFK/bookinfo.git'
                            ]]
                        ])
                    }
                    env.GIT_TAG = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                }
            }
        }

        /*
        stage('IaC Scan (KICS)') {
            steps {
                container('kics') {
                    sh "/app/bin/kics scan -p ${env.CHART_DIR} --report-formats html,json -o ."
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'results.html,results.json', fingerprint: true
                }
            }
        }*/

        stage('Static Analysis (SonarQube)') {
            steps {
                container('sonar-scanner') {
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                        sh """
                            sonar-scanner \
                              -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} \
                              -Dsonar.sources=src/productpage \
                              -Dsonar.host.url=${env.SONAR_SERVER_URL} \
                              -Dsonar.login=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('SCA (Dependency-Check)') {
            steps {
                container('dependency-check') {
                    sh '''                        
                        /usr/share/dependency-check/bin/dependency-check.sh \
                        --project "Bookinfo-productpage" \
                        --scan ./src/productpage/requirements.txt \
                        --format HTML \
                        --format XML \
                        --out . \
                        --enableExperimental
                    '''
                }
            }
            post {
                always {
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'                    
                }
            }
        }

        stage('Build & Push to Harbor') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: 'registry-bookinfo', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                        script {
                            sh "mkdir -p ${WORKSPACE}/.docker"
                            withEnv(["DOCKER_CONFIG=${WORKSPACE}/.docker"]) {
                                sh 'echo $REG_PASS | docker login $REGISTRY_URL -u $REG_USER --password-stdin'
                                dir('src/productpage') {
                                    sh "docker build -t ${env.FULL_IMAGE}:${env.GIT_TAG} ."
                                    sh "docker push ${env.FULL_IMAGE}:${env.GIT_TAG}"
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Image Scan (Trivy)') {
            steps {
                container('trivy') {
                    sh "trivy image --severity HIGH,CRITICAL --exit-code 0 ${env.FULL_IMAGE}:${env.GIT_TAG}"
                }
            }
        }

        stage('Deploy to K8s (Helm)') {
            steps {
                container('helm') {
                    sh """                        
                        helm upgrade --install ${env.RELEASE_NAME} ${env.CHART_DIR} \
                            --namespace ${env.NAMESPACE} \
                            -f ${env.VALUES_FILE} \
                            --set productpage.image.tag=${env.GIT_TAG} \
                            --wait
                    """
                }
            }
        }

        stage('DAST (OWASP ZAP)') {
            steps {
                container('zap') {
                    script {
                        sh "zap-baseline.py -t ${env.APP_URL} -r zap_report.html || true"
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap_report.html', fingerprint: true
                }
            }
        }
    }
}