pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent-ratings
spec:
  containers:
  - name: docker
    image: docker:24.0.5
    command: ['cat']
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: helm
    image: alpine/helm:3.12.0
    command: ['cat']
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
"""
        }
    }

    environment {
        REGISTRY_URL = "registry-supeem.opsta.in.th"
        IMAGE_PATH   = "library/productpage-service"
        FULL_IMAGE   = "${REGISTRY_URL}/${IMAGE_PATH}"
        CHART_DIR    = "helm-chart/productpage"
        
        RELEASE_NAME = ""
        NAMESPACE    = ""
        VALUES_FILE  = ""
    }

    stages {
        stage('Checkout & Setup') {
            steps {
                script {
                    withEnv(['GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no']) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${env.BRANCH_NAME}"]], 
                            userRemoteConfigs: [[
                                credentialsId: 'bookinfo-deploy-key',
                                url: 'git@gitlab.com:SupeemAFK/bookinfo.git'
                            ]]
                        ])
                    }
                    
                    env.GIT_TAG = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    echo "Current Version: ${env.GIT_TAG} on Branch: ${env.BRANCH_NAME}"

                    if (env.BRANCH_NAME == 'dev') {
                        env.RELEASE_NAME = "bookinfo-productpage-dev"
                        env.NAMESPACE    = "bookinfo-dev"
                        env.VALUES_FILE  = "helm-chart/productpage/dev-productpage-values.yaml"
                    } 
                    else if (env.BRANCH_NAME == 'main') {
                        env.RELEASE_NAME = "bookinfo-productpage-uat"
                        env.NAMESPACE    = "bookinfo-uat"
                        env.VALUES_FILE  = "helm-chart/productpage/uat-productpage-values.yaml" 
                    }
                    else {
                        error "Unknown branch: ${env.BRANCH_NAME}. Only 'dev' and 'main' are supported."
                    }
                }
            }
        }

        stage('Build & Push to Harbor') {
            when {
                anyOf {
                    branch 'dev'
                    branch 'main'
                }
                changeset "src/productpage/**"
            }
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: 'registry-bookinfo', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                        sh "mkdir -p ${WORKSPACE}/.docker"
                        withEnv(["DOCKER_CONFIG=${WORKSPACE}/.docker"]) {
                            script {
                                retry(3) {
                                    echo "Attempting Docker Login..."
                                    sh 'printenv REG_PASS | docker login $REGISTRY_URL -u $REG_USER --password-stdin'
                                }
                            }
                            dir('src/productpage') {
                                echo "Building and Pushing image: ${env.FULL_IMAGE}:${env.GIT_TAG}"
                                sh "docker build -t ${env.FULL_IMAGE}:${env.GIT_TAG} ."
                                retry(3) {
                                    sh "docker push ${env.FULL_IMAGE}:${env.GIT_TAG}"
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to K8s (Helm)') {
            when {
                anyOf {
                    branch 'dev'
                    branch 'main'
                }
                changeset "src/productpage/**"
            }
            steps {
                container('helm') {
                    script {
                        echo " Deploying to Environment: ${env.BRANCH_NAME}"
                        echo " Namespace: ${env.NAMESPACE}"
                        echo " Release:   ${env.RELEASE_NAME}"
                        echo " Values:    ${env.VALUES_FILE}"
                        
                        sh """                        
                            helm upgrade --install ${env.RELEASE_NAME} ${env.CHART_DIR} \
                                --namespace ${env.NAMESPACE} \
                                -f ${env.VALUES_FILE} \
                                --set productpage.image.tag=${env.GIT_TAG} \
                                --create-namespace \
                                --wait
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deployment Successful: ${env.RELEASE_NAME} (v${env.GIT_TAG})"
        }
        failure {
            echo "Deployment Failed for ${env.RELEASE_NAME}"
        }
    }
}