pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent-bookinfo
spec:
  containers:
  - name: docker
    image: docker:24.0.5
    command: ['cat']
    tty: true
    securityContext:
      privileged: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: helm
    image: alpine/helm:3.12.0
    command: ['cat']
    tty: true
  - name: sonar-scanner
    image: sonarsource/sonar-scanner-cli:latest
    command: ['cat']
    tty: true
  - name: dependency-check
    image: owasp/dependency-check:latest
    command: ['cat']
    tty: true
    securityContext:
      runAsUser: 0
    volumeMounts:
    - name: sca-data
      mountPath: /usr/share/dependency-check/data
  - name: trivy
    image: aquasec/trivy:latest
    command: ['cat']
    tty: true
  - name: zap
    image: ghcr.io/zaproxy/zaproxy:stable
    command: ['sh', '-c', 'cat']
    tty: true
  - name: kics
    image: checkmarx/kics:latest
    command: ['cat']
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
  - name: sca-data
    hostPath:
      path: /tmp/dependency-check-data
"""
        }
    }

    environment {
        REGISTRY_URL = "registry-supeem.opsta.in.th"
        IMAGE_PATH   = "library/productpage-service"
        FULL_IMAGE   = "${REGISTRY_URL}/${IMAGE_PATH}"
        CHART_DIR    = "helm-chart/productpage"
        
        SONAR_SERVER_NAME = "https://sast-supeem.opsta.in.th" 
        SONAR_PROJECT_KEY = "SupeemAFK_bookinfo_8304fcdc-fe26-4b19-a892-84f8f847e9df"

        SAFE_BRANCH  = "${env.BRANCH_NAME ?: 'dev'}"
        RELEASE_NAME = "${env.SAFE_BRANCH == 'main' ? 'bookinfo-productpage-uat' : 'bookinfo-productpage-dev'}"
        NAMESPACE    = "${env.SAFE_BRANCH == 'main' ? 'bookinfo-uat' : 'bookinfo-dev'}"
        VALUES_FILE  = "helm-chart/productpage/${env.SAFE_BRANCH == 'main' ? 'uat' : 'dev'}-productpage-values.yaml"
        
        APP_URL      = "http://productpage.${env.SAFE_BRANCH}.svc.cluster.local:9080"
    }

    stages {
        stage('Checkout & Setup') {
            steps {
                script {
                    checkout([$class: 'GitSCM',
                        branches: [[name: "*/${env.SAFE_BRANCH}"]], 
                        userRemoteConfigs: [[
                            credentialsId: 'bookinfo-deploy-key',
                            url: 'git@gitlab.com:SupeemAFK/bookinfo.git'
                        ]]
                    ])
                    env.GIT_TAG = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                }
            }
        }

        stage('IaC Scan (KICS)') {
            steps {
                container('kics') {
                    sh "/app/bin/kics scan -p ${env.CHART_DIR} --fail-on high,critical --report-formats html,json -o ."
                }
            }
            post {
                always {
                    publishHTML([reportDir: '.', reportFiles: 'results.html', reportName: 'KICS IaC Report'])
                }
            }
        }

        stage('Static Analysis (SonarQube)') {
            steps {
                container('sonar-scanner') {
                    withSonarQubeEnv("${env.SONAR_SERVER_NAME}") {
                        sh """
                            sonar-scanner \
                            -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} \
                            -Dsonar.sources=src/productpage \
                            -Dsonar.qualitygate.wait=true
                        """
                    }
                }
            }
        }
        stage("Quality Gate") {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('SCA (Dependency-Check)') {
            steps {
                container('dependency-check') {
                    sh "/usr/share/dependency-check/bin/dependency-check.sh --project 'Bookinfo' --scan './src/productpage' --format 'ALL' --out ."
                }
            }
            post {
                always {
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }

        stage('Build & Push to Harbor') {
            steps {
                container('docker') {
                    script {
                        def registryUrl = "https://${REGISTRY_URL}".toString()
                        def credsId     = 'registry-bookinfo'

                        docker.withRegistry(registryUrl, credsId) {
                            def myImage = docker.build("${env.FULL_IMAGE}:${env.GIT_TAG}", "./src/productpage")
                            retry(3) { 
                                myImage.push() 
                            }
                        }
                    }
                }
            }
        }

        stage('Image Scan (Trivy)') {
            steps {
                container('trivy') {
                    sh "trivy image --severity HIGH,CRITICAL --format template --template '@/contrib/html.tpl' -o trivy-results.html ${env.FULL_IMAGE}:${env.GIT_TAG}"
                }
            }
            post {
                always {
                    publishHTML([reportDir: '.', reportFiles: 'trivy-results.html', reportName: 'Trivy Scan'])
                }
            }
        }

        stage('Deploy (Helm)') {
            steps {
                container('helm') {
                    sh """
                        helm upgrade --install ${env.RELEASE_NAME} ${env.CHART_DIR} \
                            --namespace ${env.NAMESPACE} \
                            -f ${env.VALUES_FILE} \
                            --set productpage.image.tag=${env.GIT_TAG} \
                            --wait
                    """
                }
            }
        }

        stage('DAST (OWASP ZAP)') {
            steps {
                container('zap') {
                    sh "zap-baseline.py -t ${env.APP_URL} -r zap-report.html || true"
                }
            }
            post {
                always {
                    publishHTML([reportDir: '.', reportFiles: 'zap-report.html', reportName: 'ZAP Report'])
                }
            }
        }
    }
}