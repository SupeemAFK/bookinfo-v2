pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent-bookinfo
spec:
  containers:
  - name: docker
    image: docker:24.0.5
    command: ['cat']
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: helm
    image: alpine/helm:3.12.0
    command: ['cat']
    tty: true
 - name: sonar-scanner
    image: sonarsource/sonar-scanner-cli:latest
    command: ['cat']
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
"""
        }
    }

    environment {
        //Harbor Image
        REGISTRY_URL = "registry-supeem.opsta.in.th"
        IMAGE_PATH   = "library/productpage-service"
        FULL_IMAGE   = "${REGISTRY_URL}/${IMAGE_PATH}"
        CHART_DIR    = "helm-chart/productpage"

        //Sonar
        SONAR_SERVER_URL = "https://sast-supeem.opsta.in.th"
        SONAR_PROJECT_KEY = "SupeemAFK_bookinfo_8304fcdc-fe26-4b19-a892-84f8f847e9df"

        //Branch
        SAFE_BRANCH = "${env.BRANCH_NAME != null ? env.BRANCH_NAME : 'dev'}"

        RELEASE_NAME = "${env.SAFE_BRANCH == 'main' ? 'bookinfo-productpage-uat' : 'bookinfo-productpage-dev'}"
        NAMESPACE    = "${env.SAFE_BRANCH == 'main' ? 'bookinfo-uat' : 'bookinfo-dev'}"
        VALUES_FILE  = "${env.SAFE_BRANCH == 'main' ? 'helm-chart/productpage/uat-productpage-values.yaml' : 'helm-chart/productpage/dev-productpage-values.yaml'}"
    }

    stages {
        stage('Debug Info') {
            steps {
                script {
                    echo "Branch Detected: ${env.SAFE_BRANCH}"
                    echo "Target Namespace: ${env.NAMESPACE}"
                    echo "Target Release:   ${env.RELEASE_NAME}"
                    echo "Values File:      ${env.VALUES_FILE}"
                }
            }
        }

        stage('Checkout & Setup') {
            steps {
                script {
                    withEnv(['GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no']) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${env.SAFE_BRANCH}"]], 
                            userRemoteConfigs: [[
                                credentialsId: 'bookinfo-deploy-key',
                                url: 'git@gitlab.com:SupeemAFK/bookinfo.git'
                            ]]
                        ])
                    }
                    env.GIT_TAG = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                }
            }
        }

        stage('Static Analysis (SonarQube)') {
            steps {
                container('sonar-scanner') {
                    withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                        script {
                            sh """
                                sonar-scanner \
                                  -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} \
                                  -Dsonar.sources=src/productpage \
                                  -Dsonar.host.url=${env.SONAR_SERVER_URL} \
                                  -Dsonar.login=${SONAR_TOKEN}
                            """
                        }
                    }
                }
            }
        }

        stage('Build & Push to Harbor') {
            when {
                anyOf {
                    expression { env.SAFE_BRANCH == 'dev' }
                    expression { env.SAFE_BRANCH == 'main' }
                }
            }
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: 'registry-bookinfo', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                        sh "mkdir -p ${WORKSPACE}/.docker"
                        withEnv(["DOCKER_CONFIG=${WORKSPACE}/.docker"]) {
                            script {
                                retry(3) {
                                    sh 'printenv REG_PASS | docker login $REGISTRY_URL -u $REG_USER --password-stdin'
                                }
                            }
                            dir('src/productpage') {
                                sh "docker build -t ${env.FULL_IMAGE}:${env.GIT_TAG} ."
                                retry(3) {
                                    sh "docker push ${env.FULL_IMAGE}:${env.GIT_TAG}"
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to K8s (Helm)') {
            when {
                anyOf {
                    expression { env.SAFE_BRANCH == 'dev' }
                    expression { env.SAFE_BRANCH == 'main' }
                }
            }
            steps {
                container('helm') {
                    script {
                        sh """                        
                            helm upgrade --install ${env.RELEASE_NAME} ${env.CHART_DIR} \
                                --namespace ${env.NAMESPACE} \
                                -f ${env.VALUES_FILE} \
                                --set productpage.image.tag=${env.GIT_TAG} \
                                --wait
                        """
                    }
                }
            }
        }
    }
}