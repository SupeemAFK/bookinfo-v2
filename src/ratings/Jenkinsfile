pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent-ratings
spec:
  containers:
  - name: docker
    image: docker:24.0.5
    command: ['cat']
    tty: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  - name: helm
    image: alpine/helm:3.12.0
    command: ['cat']
    tty: true
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
"""
        }
    }

    environment {
        REGISTRY_URL = "registry-supeem.opsta.in.th"
        IMAGE_PATH   = "library/ratings-service"
        FULL_IMAGE   = "${REGISTRY_URL}/${IMAGE_PATH}"

        CHART_DIR    = "helm-chart"
        VALUES_FILE  = "helm-chart/dev-values.yaml"

        RELEASE_NAME = "bookinfo-dev"
        NAMESPACE    = "bookinfo-dev"
    }

    stages {
        stage('Checkout & Setup') {
            steps {
                script {
                    withEnv(['GIT_SSH_COMMAND=ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no']) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: '*/dev']],
                            userRemoteConfigs: [[
                                credentialsId: 'bookinfo-deploy-key',
                                url: 'git@gitlab.com:SupeemAFK/bookinfo.git'
                            ]]
                        ])
                    }
                    env.GIT_TAG = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    echo "Current Version: ${env.GIT_TAG}"
                }
            }
        }

        stage('Build & Push to Harbor') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: 'registry-bookinfo', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                        sh "docker login ${env.REGISTRY_URL} -u '${REG_USER}' -p '${REG_PASS}'"

                        dir('src/ratings') {
                            echo "Building and Pushing image: ${env.FULL_IMAGE}:${env.GIT_TAG}"
                            sh "docker build -t ${env.FULL_IMAGE}:${env.GIT_TAG} ."
                            sh "docker push ${env.FULL_IMAGE}:${env.GIT_TAG}"
                        }
                    }
                }
            }
        }

        stage('Deploy to K8s with Helm') {
            steps {
                container('helm') {
                    echo "Upgrading release ${env.RELEASE_NAME} in namespace ${env.NAMESPACE}"
                    sh """
                        helm dependency update ${env.CHART_DIR}
                        
                        helm upgrade --install ${env.RELEASE_NAME} ${env.CHART_DIR} \
                            --namespace ${env.NAMESPACE} \
                            -f ${env.VALUES_FILE} \
                            --set ratings.image.tag=${env.GIT_TAG} \
                            --wait
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Deployment Successful: version ${env.GIT_TAG}"
        }
        failure {
            echo "Deployment Failed: Please check the Jenkins Console Output."
        }
    }
}